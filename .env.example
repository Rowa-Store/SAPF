# ---------------------------------------------------------------------------
# Copie este arquivo para .env.local (uso local) e configure as mesmas
# variáveis no painel do Vercel (Settings > Environment Variables).
# Nenhuma credencial deve ser commitada no repositório.
# ---------------------------------------------------------------------------

# Shopify — Admin API (pedidos e transferências de estoque). O token precisa
# dos escopos de pedidos e também de read_inventory_transfers, read_locations,
# read_inventory e read_products.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_TOKEN=
SHOPIFY_API_VERSION=

# Tiny (Olist) — token REAL. Leitura é segura; inclusão de nota cria rascunho
# de verdade no Tiny de produção (ver README, seção "Travas de segurança").
TINY_API_TOKEN=
TINY_API_BASE=

# Tiny — uma conta por loja. Nota de TRANSFERÊNCIA sai da conta Olist da
# loja de ORIGEM, com o token da variável abaixo. O nome da variável sai do
# nome do local no Shopify: sem acento, maiúsculas, espaço e pontuação viram
# "_" (ver variavelTokenDaLoja em src/lib/integrations/tiny.js). Renomear o
# local no Shopify muda o nome da variável.
# Sem a variável da loja de origem, a nota não é criada. Exceção: os CDs (Rowa
# Centro de Distribuição 1, 2 e [PRÉ-VENDA]) emitem pela conta da matriz
# (TINY_API_TOKEN) e não têm variável própria (LOCAIS_DA_MATRIZ em src/lib/integrations/tinyContas.js).
# Só precisa de token a loja que for ORIGEM de alguma transferência.
# Rowa  Morumbi Shopping
TINY_API_TOKEN_ROWA_MORUMBI_SHOPPING=
# Rowa  Oscar Freire
TINY_API_TOKEN_ROWA_OSCAR_FREIRE=
# Rowa  Shopping Anália Franco
TINY_API_TOKEN_ROWA_SHOPPING_ANALIA_FRANCO=
# Rowa Shopping Center Norte
TINY_API_TOKEN_ROWA_SHOPPING_CENTER_NORTE=
# Rowa Bh Shopping
TINY_API_TOKEN_ROWA_BH_SHOPPING=
# Rowa Diamon Mall Bh
TINY_API_TOKEN_ROWA_DIAMON_MALL_BH=
# Rowa Boa Vista Village - Town Center
TINY_API_TOKEN_ROWA_BOA_VISTA_VILLAGE_TOWN_CENTER=
# Rowa Botânico Shopping
TINY_API_TOKEN_ROWA_BOTANICO_SHOPPING=

# SintegrAPI — consulta a inscrição estadual (IE) do cliente de atacado pelo
# CNPJ quando ela ainda não está na tabela clientes_ie do Supabase. Chave no
# dashboard do SintegrAPI. Cada consulta gasta crédito; vazia, a IE fica para
# ser preenchida à mão na tela do rascunho.
SINTEGRAPI_API_KEY=

# Supabase — chave service role, usada apenas no servidor (API Routes).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Valor inicial da trava de emissão fiscal, só usado se a linha
# "permitir_emissao" ainda não existir na tabela configuracoes do Supabase.
# Mantenha false: com false, nota.fiscal.emitir nunca é chamado.
PERMITIR_EMISSAO=false
